# Supabase (browser-safe, exposed to the client)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# OpenAI — SERVER-SIDE ONLY (used by netlify/functions/ai.ts).
# Do NOT prefix with VITE_: VITE_ variables are bundled into the public JavaScript.
# In production, set these in Netlify → Site configuration → Environment variables.
# Locally, `npm run dev` reads them from .env and serves /api/ai itself.
OPENAI_API_KEY=your_openai_api_key

# Optional model overrides
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Set to "false" to allow /api/ai calls without a signed-in Supabase session (local testing only)
# AI_REQUIRE_AUTH=false
